#
# R619AC (128M NAND) — ImmortalWrt 25.12
# 需求：Sing-Box 内核的 PassWall + 分流、WireGuard 服务端、无无线、保留 PPPoE 与 IPv6
#

#
# 机型：P&W R619AC（128M NAND）
#
CONFIG_TARGET_ipq40xx=y
CONFIG_TARGET_ipq40xx_generic=y
CONFIG_TARGET_ipq40xx_generic_DEVICE_p2w_r619ac-128m=y

#
# PPPoE 拨号
#
CONFIG_PACKAGE_luci-proto-ppp=y
CONFIG_PACKAGE_ppp-mod-pppoe=y
CONFIG_PACKAGE_kmod-pppoe=y

#
# IPv6
#
CONFIG_IPV6=y
CONFIG_PACKAGE_dnsmasq_full_dhcpv6=y
CONFIG_PACKAGE_odhcp6c=y
CONFIG_PACKAGE_odhcpd-ipv6only=y
CONFIG_PACKAGE_luci-proto-ipv6=y
CONFIG_PACKAGE_kmod-ip6tables=y
CONFIG_PACKAGE_kmod-ip6tables-extra=y
CONFIG_PACKAGE_ip6tables-mod-nat=y
CONFIG_PACKAGE_kmod-ipt-nat6=y

#
# WireGuard 服务端（外网回家）
# 新版 LuCI 没有独立的 luci-app-wireguard，服务端配置在「网络 - 接口 - 协议 WireGuard」
# 首次部署可直接执行固件自带的 wg-server-init（见 files/usr/bin/wg-server-init）
#
CONFIG_PACKAGE_kmod-wireguard=y
CONFIG_PACKAGE_wireguard-tools=y
CONFIG_PACKAGE_luci-proto-wireguard=y
CONFIG_PACKAGE_qrencode=y

#
# PassWall：只保留 Sing-Box 内核，并带分流数据
# 分流依赖 /usr/share/v2ray/{geosite,geoip}.dat，由 v2ray-geodata 提供，
# passwall 的 util_sing-box.lua 会直接读这两个文件，缺了 geoip:/geosite: 规则就是空的
#
CONFIG_PACKAGE_luci-app-passwall=y
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_SingBox=y
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_V2ray_Geodata=y
# Geoview 不是可选的查看器：sing-box 内核要用它把 geosite.dat/geoip.dat 转成 .srs 规则集，
# 缺了它 passwall 会直接在日志里打「缺少 Geoview 组件，Sing-Box 分流无法启用」
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Geoview=y
CONFIG_PACKAGE_sing-box=y
CONFIG_PACKAGE_v2ray-geoip=y
CONFIG_PACKAGE_v2ray-geosite=y
CONFIG_PACKAGE_luci-i18n-passwall-zh-cn=y

# 其他内核与可选组件全部关闭（这些在 ARM 上默认是 y，不关会白带 20MB+）
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Xray is not set
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Xray_Plugin is not set
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_V2ray_Plugin is not set
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_SmartDNS is not set
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Haproxy is not set
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Simple_Obfs is not set
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_ShadowsocksR_Libev_Client is not set
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Hysteria is not set
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_NaiveProxy is not set
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Shadow_TLS is not set
# CONFIG_PACKAGE_xray-core is not set

# 同一功能的其它代理插件，明确关掉（kenzok8 源里都有同名包）
# CONFIG_PACKAGE_luci-app-openclash is not set
# CONFIG_PACKAGE_luci-app-passwall2 is not set
# CONFIG_PACKAGE_luci-app-ssr-plus is not set

#
# 透明代理底层依赖（显式声明，防止 defconfig 漏选）
#
CONFIG_PACKAGE_kmod-nft-tproxy=y
CONFIG_PACKAGE_iptables-mod-tproxy=y
CONFIG_PACKAGE_ipset=y
CONFIG_PACKAGE_kmod-ipt-ipset=y
CONFIG_PACKAGE_kmod-tun=y

#
# 无线：全部关闭
# ipq40xx 的 DEFAULT_PACKAGES 里是 kmod-ath10k-ct + wpad-openssl +
# ath10k-firmware-qca4019-ct，必须按这三个真实名字关，关闭 kmod-ath10k/wpad-basic 是无效的
#
# CONFIG_PACKAGE_kmod-ath10k-ct is not set
# CONFIG_PACKAGE_kmod-ath10k is not set
# CONFIG_PACKAGE_ath10k-firmware-qca4019-ct is not set
# CONFIG_PACKAGE_ath10k-board-qca4019 is not set
# CONFIG_PACKAGE_wpad-openssl is not set
# CONFIG_PACKAGE_wpad-basic-mbedtls is not set
# CONFIG_PACKAGE_wpad is not set
# CONFIG_PACKAGE_kmod-mac80211 is not set
# CONFIG_PACKAGE_kmod-cfg80211 is not set

#
# DDNS：动态公网 IP 下维持域名解析
# ddns-go 来自 kenzok8/small-package（kenzo 源），diy-part2.sh 的去重不会删它
#
CONFIG_PACKAGE_ddns-go=y
CONFIG_PACKAGE_luci-app-ddns-go=y
CONFIG_PACKAGE_luci-i18n-ddns-go-zh-cn=y

#
# 应用
#
CONFIG_PACKAGE_luci-app-firewall=y
CONFIG_PACKAGE_luci-app-upnp=y
CONFIG_PACKAGE_luci-app-autoreboot=y
CONFIG_PACKAGE_luci-app-ttyd=y
CONFIG_PACKAGE_luci-app-package-manager=y

#
# 主题与界面
#
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-theme-argon=y
CONFIG_PACKAGE_luci-app-argon-config=y
CONFIG_LUCI_LANG_zh_Hans=y

#
# 系统基础
#
CONFIG_PACKAGE_default-settings=y
CONFIG_PACKAGE_default-settings-chn=y
CONFIG_PACKAGE_dnsmasq-full=y
CONFIG_PACKAGE_ca-certificates=y

#
# 基础工具
#
CONFIG_PACKAGE_bash=y
CONFIG_PACKAGE_nano=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_wget-ssl=y
CONFIG_PACKAGE_fdisk=y
CONFIG_PACKAGE_lsblk=y
CONFIG_PACKAGE_mount-utils=y
CONFIG_PACKAGE_lscpu=y
CONFIG_PACKAGE_unzip=y
CONFIG_PACKAGE_jq=y
CONFIG_PACKAGE_openssh-sftp-server=y
